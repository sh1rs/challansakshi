# Optional controlled synthetic analysis for a separately access-protected environment. Public production keeps
# both switches false. Never use real citizen documents with this route.
ANALYSIS_ENABLED=false
SYNTHETIC_UPLOADS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Set this to the trusted deployed origin so Open Graph URLs are absolute.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
